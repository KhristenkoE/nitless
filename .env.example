# One LLM provider. The key picks the provider; LLM_PROVIDER overrides (anthropic, openai, gemini, github,
# openrouter, ollama, openai_compat). MODEL_STRONG is required.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# LLM_PROVIDER=
# LLM_BASE_URL=
# MODEL_STRONG=
# MODEL_FAST=

# Where to post. GitHub Actions provides GITHUB_TOKEN.
# GITHUB_TOKEN=
# GITLAB_TOKEN=
